---
import type { PostMeta } from '@estrivault/content-processor';
import CategoryMenu from '$components/CategoryMenu.astro';
import ArchivePagination from '$components/ArchivePagination.astro';
import ArchivePostRow from '$components/ArchivePostRow.astro';
import EditorialFooter from '$components/EditorialFooter.astro';
import EditorialMasthead from '$components/EditorialMasthead.astro';
import { encodeRouteSegment, getArchivePagePath } from '$lib/url-segments.mjs';
interface Props {
  title: string;
  description?: string;
  posts: PostMeta[];
  total: number;
  page: number;
  totalPages: number;
  routeBase: string;
  tagRouteMap?: ReadonlyMap<string, string>;
  topTags?: string[];
  emptyMessage: string;
}
const {
  title,
  description,
  posts,
  total,
  page,
  totalPages,
  routeBase,
  tagRouteMap = new Map(),
  topTags = [],
  emptyMessage,
} = Astro.props;
function getTagHref(tag: string): string {
  const segment = tagRouteMap.get(tag);
  if (!segment) throw new Error(`No route segment found for archive tag: ${tag}`);
  return getArchivePagePath(`/tag/${encodeRouteSegment(segment)}`, 1);
}
---

<div class="archive-page">
  <EditorialMasthead />
  <section class="archive-index" aria-labelledby="archive-title">
    <div class="listing-heading"><h1 id="archive-title">{title}</h1><CategoryMenu /></div>
    <div class="archive-context">
      {description && <p>{description}</p>}
      <p>{total}件の記事 · {page} / {totalPages}ページ</p>
      {
        topTags.length > 0 && (
          <nav class="archive-tags" aria-label="関連タグ">
            {topTags.slice(0, 5).map((tag) => (
              <a href={getTagHref(tag)}>#{tag}</a>
            ))}
          </nav>
        )
      }
    </div>
    {
      posts.length > 0 ?
        <ol class="post-list">
          {posts.map((post) => (
            <li>
              <ArchivePostRow post={post} headingLevel="h2" />
            </li>
          ))}
        </ol>
      : <p class="empty-state">{emptyMessage}</p>
    }
  </section>
  <ArchivePagination page={page} totalPages={totalPages} routeBase={routeBase} />
  <EditorialFooter />
</div>
<style>
  .archive-context {
    margin: 0 0 1.4rem;
    color: var(--color-muted);
    font-size: 0.85rem;
    line-height: 1.8;
  }
  .archive-context p {
    margin: 0.5rem 0;
  }
  .archive-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.75rem;
  }
  .post-list {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .empty-state {
    padding: 2rem 0;
    color: var(--color-muted);
  }
</style>
