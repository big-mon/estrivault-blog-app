---
import type { PostMeta } from '@estrivault/content-processor';
import { getCategoryLabel } from '$constants';
import { formatEditorialDate } from '$lib/format-date';

interface Props {
  post: PostMeta;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel: Heading = 'h3' } = Astro.props;

const formattedDate = formatEditorialDate(post.publishedAt);
---

<article class="post-row">
  <div class="post-copy">
    <div class="post-date">
      <time datetime={post.publishedAt.toISOString()}>{formattedDate}</time>
      <a href={`/category/${encodeURIComponent(post.category.toLowerCase())}/`}
        >{getCategoryLabel(post.category)}</a
      >
    </div>
    <Heading class="post-title"><a href={`/post/${post.slug}`}>{post.title}</a></Heading>
    <p class="post-description">{post.description}</p>
  </div>
</article>

<style>
  .post-title,
  .post-description {
    margin: 0;
  }
  .post-title a {
    color: inherit;
    text-decoration: none;
  }
  .post-date a {
    color: var(--color-accent);
    text-underline-offset: 0.2rem;
  }
  .post-row {
    display: block;
    min-height: 0;
    border-top: 1px solid var(--color-line);
    padding: 1.6rem 0;
    color: inherit;
    text-decoration: none;
  }
  .post-row:hover .post-title {
    color: var(--color-accent);
  }
  .post-date {
    font-family: var(--font-meta);
    font-style: normal;
  }
  .post-date time {
    color: var(--color-accent);
  }
  .post-date,
  .post-copy {
    display: flex;
  }
  .post-date {
    flex-flow: row wrap;
    gap: 0.35rem 0.75rem;
    color: #222;
    font-size: 0.86rem;
  }

  .post-copy {
    flex-direction: column;
    min-width: 0;
    gap: 0.55rem;
  }
  .post-title {
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.5;
    transition: color 120ms ease;
  }
  .post-description {
    display: -webkit-box;
    overflow: hidden;
    color: #666;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  @media (max-width: 900px) {
    .post-row {
      min-height: 0;
    }
  }
</style>
