---
import { SITE_TITLE } from '$constants';
import { AUTHOR_AVATAR_SRC } from '$lib/author-avatar';
interface Props {
  homePage?: boolean;
}
const { homePage = false } = Astro.props;
const path = Astro.url.pathname;
---

<header class="editorial-masthead">
  {
    homePage ?
      <h1 class="brand">
        <a href="/">
          <img src={AUTHOR_AVATAR_SRC} alt="" width="60" height="60" />
          {SITE_TITLE}
        </a>
      </h1>
    : <div class="brand">
        <a href="/">
          <img src={AUTHOR_AVATAR_SRC} alt="" width="60" height="60" />
          {SITE_TITLE}
        </a>
      </div>
  }
  <nav aria-label="Primary navigation">
    <a href="/" aria-current={path === '/' ? 'page' : undefined}>記事</a>
    <a href="/notes/" aria-current={path.startsWith('/notes') ? 'page' : undefined}>メモ</a>
    <a href="/post/about" aria-current={path === '/post/about' ? 'page' : undefined}
      >このブログについて</a
    >
  </nav>
</header>
<style>
  .editorial-masthead {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    padding: 0 0 1.6rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-line);
  }
  .brand {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(3.5rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
  }
  .brand a {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
  }
  .brand img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
  }
  a {
    color: #20231e;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.4rem;
    font-size: 0.88rem;
  }
  nav a {
    padding: 0.5rem 0;
  }
  nav a[aria-current],
  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }
  @media (max-width: 900px) {
    .brand {
      font-size: 3rem;
    }
    .brand img {
      width: 48px;
      height: 48px;
    }
    .editorial-masthead {
      gap: 1rem;
      margin-bottom: 2rem;
    }
    nav {
      gap: 1rem;
    }
  }
</style>
