---
import { getArchivePagePath } from '$lib/url-segments.mjs';

interface Props {
  page: number;
  totalPages: number;
  routeBase: string;
}

type PaginationItem = { type: 'page'; pageNumber: number } | { type: 'ellipsis'; key: string };

const { page, totalPages, routeBase } = Astro.props;

function getVisiblePaginationItems(currentPage: number, pageCount: number): PaginationItem[] {
  if (pageCount <= 7) {
    return Array.from({ length: pageCount }, (_, index) => ({
      type: 'page',
      pageNumber: index + 1,
    }));
  }

  const pageNumbers = new Set([1, pageCount, currentPage - 1, currentPage, currentPage + 1]);

  if (currentPage <= 4) {
    [2, 3, 4, 5].forEach((pageNumber) => pageNumbers.add(pageNumber));
  }

  if (currentPage >= pageCount - 3) {
    [pageCount - 4, pageCount - 3, pageCount - 2, pageCount - 1].forEach((pageNumber) =>
      pageNumbers.add(pageNumber),
    );
  }

  const sortedPages = [...pageNumbers]
    .filter((pageNumber) => pageNumber >= 1 && pageNumber <= pageCount)
    .sort((a, b) => a - b);

  return sortedPages.flatMap((pageNumber, index): PaginationItem[] => {
    const previousPage = sortedPages[index - 1];
    const gap =
      previousPage !== undefined && pageNumber - previousPage > 1 ?
        [{ type: 'ellipsis' as const, key: `${previousPage}-${pageNumber}` }]
      : [];

    return [...gap, { type: 'page', pageNumber }];
  });
}

const visiblePaginationItems = getVisiblePaginationItems(page, totalPages);
---

{
  totalPages > 1 && (
    <nav class="archive-pagination" aria-label="ページネーション">
      {page > 1 ?
        <a href={getArchivePagePath(routeBase, page - 1)} aria-label="前のページ">
          ← 前へ
        </a>
      : <span aria-disabled="true">← 前へ</span>}
      <div>
        {visiblePaginationItems.map((item) =>
          item.type === 'ellipsis' ?
            <span class="pagination-ellipsis" aria-hidden="true">
              …
            </span>
          : item.pageNumber === page ?
            <span aria-current="page">{String(item.pageNumber).padStart(2, '0')}</span>
          : <a
              href={getArchivePagePath(routeBase, item.pageNumber)}
              aria-label={`${item.pageNumber}ページ目`}
            >
              {String(item.pageNumber).padStart(2, '0')}
            </a>,
        )}
      </div>
      {page < totalPages ?
        <a href={getArchivePagePath(routeBase, page + 1)} aria-label="次のページ">
          次へ →
        </a>
      : <span aria-disabled="true">次へ →</span>}
    </nav>
  )
}

<style>
  .archive-pagination,
  .archive-pagination > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .archive-pagination {
    margin: 2rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.85rem;
  }
  .archive-pagination :is(a, span) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--color-line);
    text-decoration: none;
  }
  .archive-pagination a:hover {
    background: var(--color-tint);
    border-color: var(--color-accent);
  }
  .archive-pagination [aria-current='page'] {
    background: var(--color-accent);
    color: var(--color-surface);
    border-color: var(--color-accent);
  }
  .archive-pagination [aria-disabled='true'] {
    color: var(--color-muted);
    border-color: transparent;
  }
  .archive-pagination .pagination-ellipsis {
    border-color: transparent;
    padding-inline: 0.2rem;
  }
</style>
