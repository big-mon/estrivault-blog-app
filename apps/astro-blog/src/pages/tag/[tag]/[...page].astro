---
import BaseLayout from '$layouts/BaseLayout.astro';
import ArchiveListing from '$components/ArchiveListing.astro';
import { POSTS_PER_PAGE, SITE_TITLE, SITE_URL } from '$constants';
import { getArchiveTagStats } from '$lib/archive-tags';
import { filterPosts, getAllPostsMeta, getPaginatedPosts } from '$lib/content';
import { encodeRouteSegment, getArchivePageUrl, getTagRouteMap } from '$lib/url-segments.mjs';

interface Props {
  tag: string;
  tagRouteSegment: string;
}

export async function getStaticPaths() {
  const allPosts = await getAllPostsMeta();
  const tags = [...new Set(allPosts.flatMap((post) => post.tags))].sort((a, b) =>
    a.localeCompare(b),
  );
  const tagRouteMap = getTagRouteMap(tags);
  const paths = [];

  for (const tag of tags) {
    const tagPosts = getPaginatedPosts(allPosts, { tag, perPage: POSTS_PER_PAGE });
    const routeSegment = tagRouteMap.get(tag);
    if (!routeSegment) {
      throw new Error(`No route segment found for public tag: ${tag}`);
    }

    for (let page = 1; page <= tagPosts.totalPages; page++) {
      paths.push({
        params: {
          tag: routeSegment,
          page: page === 1 ? undefined : String(page),
        },
        props: {
          tag,
          tagRouteSegment: routeSegment,
        },
      });
    }
  }

  return paths;
}

const { tag, tagRouteSegment } = Astro.props as Props;
const currentPage = Number(Astro.params.page ?? '1');
const allPosts = await getAllPostsMeta();
const tagRouteMap = getTagRouteMap(allPosts.flatMap((post) => post.tags));
const archivePosts = filterPosts(allPosts, { tag });
const result = getPaginatedPosts(archivePosts, {
  page: currentPage,
  perPage: POSTS_PER_PAGE,
});
const { topTags, uniqueTagCount } = getArchiveTagStats(archivePosts, tag);

const siteBase = SITE_URL.replace(/\/$/, '');
const encodedTagRouteSegment = encodeRouteSegment(tagRouteSegment);
const routeBase = `/tag/${encodedTagRouteSegment}`;
const pageUrl = getArchivePageUrl(siteBase, routeBase, currentPage);
const pageTitle = `${tag}の記事一覧${currentPage > 1 ? ` - ページ${currentPage}` : ''} | ${SITE_TITLE}`;
const pageDescription = `${tag}タグが付けられた記事一覧${currentPage > 1 ? `（${currentPage}ページ目）` : ''}です。全${result.total}件の記事を掲載しています。`;

const prevUrl =
  currentPage > 1 ? getArchivePageUrl(siteBase, routeBase, currentPage - 1) : undefined;
const nextUrl =
  currentPage < result.totalPages ?
    getArchivePageUrl(siteBase, routeBase, currentPage + 1)
  : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  hideHeader
  hideFooter
  bodyClass="archive-editorial-page"
  mainClass="archive-editorial-main"
>
  <ArchiveListing
    archiveType="TAG"
    title={`#${tag}`}
    description={`${tag}タグが付けられた記事を、新しい順にまとめた一覧です。`}
    posts={result.posts}
    total={result.total}
    page={result.page}
    totalPages={result.totalPages}
    routeBase={routeBase}
    tagRouteMap={tagRouteMap}
    topTags={topTags}
    sideMeta={[
      { label: 'TYPE', value: 'TAG' },
      { label: 'TAG', value: tag },
      { label: 'ARTICLES', value: result.total },
      { label: 'TAGS', value: uniqueTagCount },
    ]}
    emptyMessage="このタグにはまだ記事がありません。"
  />
</BaseLayout>
