---
import BaseLayout from '$layouts/BaseLayout.astro';
import EditorialFooter from '$components/EditorialFooter.astro';
import EditorialMasthead from '$components/EditorialMasthead.astro';
import ArchivePostRow from '$components/ArchivePostRow.astro';
import ArchivePagination from '$components/ArchivePagination.astro';
import CategoryMenu from '$components/CategoryMenu.astro';
import NoteCard from '$components/NoteCard.astro';
import NoteModal from '$components/NoteModal.astro';
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '$constants';
import { getAllNotes, getAllPostsMeta, getPaginatedPosts } from '$lib/content';
const allPosts = await getAllPostsMeta();
const recentNoteDetails = (await getAllNotes()).slice(0, 4);
const pageData = getPaginatedPosts(allPosts, { page: 1, perPage: POSTS_PER_PAGE });
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  canonical={SITE_URL}
  hideHeader
  hideFooter
  bodyClass="editorial-page"
  mainClass="editorial-main"
>
  <div class="editorial-home">
    <EditorialMasthead homePage />
    <section id="latest" aria-labelledby="latest-title">
      <div class="section-heading-row"><h2 id="latest-title">最近の記事</h2><CategoryMenu /></div>
      <ol class="post-list">
        {
          pageData.posts.map((post) => (
            <li>
              <ArchivePostRow post={post} />
            </li>
          ))
        }
      </ol>
      <ArchivePagination page={1} totalPages={pageData.totalPages} routeBase="" />
    </section>
    {
      recentNoteDetails.length > 0 && (
        <section id="recent-notes">
          <div class="section-heading-row">
            <>
              <h2>RECENT NOTES</h2>
              <a href="/notes/">すべての Notes →</a>
            </>
          </div>
          <div class="recent-notes-grid">
            {recentNoteDetails.map((note) => (
              <NoteCard note={note.meta} compact />
            ))}
          </div>
        </section>
      )
    }
    <EditorialFooter />
  </div>
  <NoteModal notes={recentNoteDetails} basePath="/" />
</BaseLayout>
<style>
  .section-heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }
  h2 {
    margin: 0;
    color: #52634d;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #recent-notes {
    margin-top: 3rem;
  }
  .section-heading-row > a {
    color: #52634d;
    font-size: 0.8rem;
  }
  .recent-notes-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 600px) {
    .recent-notes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
