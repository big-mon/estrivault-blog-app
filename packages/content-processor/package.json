{
  "name": "@estrivault/content-processor",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean-workspace-dist.mjs",
    "build:types": "tsc --build",
    "build:bundle": "tsup",
    "build": "pnpm run build:types && pnpm run build:bundle"
  },
  "dependencies": {
    "@estrivault/cloudinary-utils": "workspace:^",
    "gray-matter": "^4.0.3",
    "micromark-util-decode-string": "^2.0.1",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/unist": "^3.0.3",
    "tsup": "^8.5.1"
  }
}
