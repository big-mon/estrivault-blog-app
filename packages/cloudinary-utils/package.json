{
  "name": "@estrivault/cloudinary-utils",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean-workspace-dist.mjs",
    "build:types": "tsc --build",
    "build:bundle": "esbuild src/index.ts --bundle --packages=external --format=esm --platform=node --target=es2022 --outdir=dist --minify --keep-names --sourcemap=external --splitting",
    "build": "pnpm run build:types && pnpm run build:bundle",
    "dev": "pnpm run build:bundle --watch"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@cloudinary/url-gen": "^1.22.0"
  }
}
