{
  "name": "@estrivault/og-image-generator",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node ../../scripts/clean-workspace-dist.mjs",
    "build:types": "tsc --build",
    "build:bundle": "esbuild src/index.ts --bundle --packages=external --format=esm --platform=node --target=es2022 --outdir=dist --minify --keep-names --sourcemap=external --loader:.otf=file",
    "build": "pnpm run build:types && pnpm run build:bundle",
    "dev": "pnpm run build:bundle --watch",
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "react": "^19.3.0",
    "satori": "^0.33.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0"
  }
}
